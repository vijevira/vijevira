---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  SITE_NAME,
  SITE_ALT_NAME,
  PERSON_ID,
  WEBSITE_ID,
} from "../consts";

// Single source of truth for the Person entity. Other pages reference
// PERSON_ID / WEBSITE_ID instead of duplicating these nodes.
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": PERSON_ID,
  name: SITE_NAME,
  alternateName: SITE_ALT_NAME,
  jobTitle: "Senior Software Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Apsona",
    url: "https://apsona.com",
  },
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  image: `${SITE_URL}/profile.png`,
  sameAs: [
    "https://github.com/vijevira",
    "https://github.com/vijevirat",
    "https://www.linkedin.com/in/vijevira",
    "https://twitter.com/vijevirat",
    "https://www.instagram.com/vijevira",
    "https://www.facebook.com/vijevirat",
  ],
  knowsAbout: [
    "Backend Engineering",
    "Node.js",
    "AI Systems",
    "Payment Integrations",
    "DevOps",
    "System Architecture",
    "Cloudflare Workers",
    "HashiCorp Vault",
    "Salesforce Development",
    "Real-Time Payment Systems (SEPA, SWIFT, NACH)",
  ],
};

const profilePageLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE_URL}/#profilepage`,
  url: SITE_URL,
  name: SITE_TITLE,
  mainEntity: { "@id": PERSON_ID },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  url: SITE_URL,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  publisher: { "@id": PERSON_ID },
  author: { "@id": PERSON_ID },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image="/profile.png"
      structuredData={[personLd, profilePageLd, websiteLd]}
    />
  </head>
  <body>
    <Header />
    <main>
      <h2>👋 Hi, I'm Vijendra Kumar</h2>
      <p>
        I'm a <strong>Senior Software Engineer at Apsona</strong
        >, based in Bangalore, India, where I focus on <strong
          >backend engineering, Salesforce automation,</strong
        > and <strong>DevOps</strong> — things like Vault-based secrets management,
        triggered merge automation, and scheduler tooling.
      </p>
      <p>
        My career started at <strong>TCS</strong> in 2021, and I later spent time
        at <strong>Pratishthan Software Ventures</strong> building real-time payment
        infrastructure for banks — <strong>SEPA</strong>, <strong>SWIFT</strong
        >, <strong>NACH</strong>, <strong>QCBIP</strong>, and <strong
          >UAERT</strong
        >. Outside my day job I build side projects, from multiplayer games to
        <strong>AI-powered tools</strong> and SaaS platforms, and I've solved <strong
          >350+ coding problems</strong
        > across various platforms.
      </p>

      <h3>🛠️ What I work with</h3>
      <ul>
        <li>Node.js, Python, TypeScript, Shell scripting</li>
        <li>PostgreSQL, Redis, Node-RED</li>
        <li>HashiCorp Vault, Salesforce, AWS Lambda/SQS</li>
        <li>Cloudflare Workers, Durable Objects, Docker, Turborepo</li>
      </ul>

      <h3>🔗 Explore</h3>
      <ul>
        <li>📖 Read the full story on <a href="/about">About</a></li>
        <li>💻 Browse what I've built in <a href="/projects">Projects</a></li>
        <li>📄 See my full career history on my <a href="/resume">Resume</a></li>
      </ul>

      <h3>🚀 Let's Build Something Amazing</h3>
      <p>
        I'm always open to exciting collaborations, freelance gigs, or
        full-time roles where I can solve real problems, learn with smart
        folks, and make a meaningful impact. <a href="mailto:vijevira@engineer.com"
          >Say hello</a
        > — let's build something awesome together!
      </p>
    </main>
    <Footer />
  </body>
</html>
