---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, PERSON_ID, WEBSITE_ID } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

// Sort by whichever is more recent — an edited older project should rank
// above an untouched newer one.
const sortDate = (post: (typeof posts)[number]) =>
	(post.data.updatedDate ?? post.data.pubDate).valueOf();

const posts = (await getCollection('projects')).sort((a, b) => {
	const pinDiff = Number(!!b.data.pinned) - Number(!!a.data.pinned);
	if (pinDiff !== 0) return pinDiff;
	return sortDate(b) - sortDate(a);
});

const pageTitle = 'Projects – Vijendra Kumar (Vijevira)';
const pageDescription =
	'Backend engineering, AI systems, payment integration, and DevOps projects built by Vijendra Kumar (Vijevira), including SEPA, SWIFT, and NACH payment systems.';

// References the Person/WebSite nodes published on the homepage rather
// than duplicating them here.
const collectionPageLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	url: `${SITE_URL}/projects`,
	name: pageTitle,
	description: pageDescription,
	author: { '@id': PERSON_ID },
	isPartOf: { '@id': WEBSITE_ID },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} structuredData={collectionPageLd} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/projects/${post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										{post.data.hidePubDate && 'Updated '}
										<FormattedDate
											date={post.data.hidePubDate
												? (post.data.updatedDate ?? post.data.pubDate)
												: post.data.pubDate}
										/>
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
